# ========================================================
# STAYEASE HOTEL MANAGEMENT SYSTEM
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your actual Neon PostgreSQL connection string and secret key.
# 3. NEVER commit your actual .env file to GitHub.
# ========================================================

# 1. Database Connection URL
# For Neon PostgreSQL (Pooled serverless connection recommended):
# Example: postgresql://username:password@ep-crimson-bar-123456-pooler.ap-southeast-1.aws.neon.tech/stayease?sslmode=require
DATABASE_URL=postgresql://username:password@hostname.neon.tech/stayease?sslmode=require

# 2. Secret Key for JWT Signing
# Generate a secure random token in Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# 3. Initial Administrator Credentials (For database/init_db.py)
ADMIN_NAME=StayEase Administrator
ADMIN_EMAIL=admin@stayease.com
ADMIN_PASSWORD=admin123
